<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Özdenetim Akademisi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&display=swap');
        body { font-family: 'Quicksand', sans-serif; background-color: #f0f9ff; margin: 0; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .progress-fill { transition: width 0.8s ease-out; }
        #loader { position: fixed; inset: 0; background: #4f46e5; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 100; color: white; transition: opacity 0.5s ease; }
    </style>
</head>
<body class="p-4">
    <div id="loader">
        <div class="animate-spin rounded-full h-16 w-16 border-t-4 border-white mb-4"></div>
        <p class="font-bold text-xl">Akademi Yükleniyor...</p>
    </div>

    <div id="game-box" class="max-w-2xl w-full bg-white rounded-3xl shadow-2xl overflow-hidden border-4 border-indigo-100 opacity-0 transition-opacity duration-700">
        <div class="bg-indigo-600 p-6 text-white text-center relative">
            <h1 class="text-2xl font-bold">🎯 Özdenetim Akademisi</h1>
            <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 bg-amber-400 text-indigo-900 px-6 py-1 rounded-full font-bold shadow-lg text-sm border-2 border-white">
                Görev: <span id="display-label">Başlıyor...</span>
            </div>
        </div>

        <div class="pt-12 px-8 pb-4 grid grid-cols-2 gap-6">
            <div class="bg-blue-50 p-4 rounded-2xl border border-blue-100">
                <p class="text-xs font-bold text-blue-500 uppercase">Akademik Kararlılık</p>
                <div class="w-full bg-blue-200 h-3 rounded-full overflow-hidden mt-1"><div id="bar-sebat" class="bg-blue-500 h-full progress-fill" style="width: 50%"></div></div>
            </div>
            <div class="bg-rose-50 p-4 rounded-2xl border border-rose-100">
                <p class="text-xs font-bold text-rose-500 uppercase">Akademik Dikkat</p>
                <div class="w-full bg-rose-200 h-3 rounded-full overflow-hidden mt-1"><div id="bar-dikkat" class="bg-rose-500 h-full progress-fill" style="width: 50%"></div></div>
            </div>
        </div>

        <div class="p-8">
            <div id="scenario-container" class="bg-indigo-50 border-2 border-indigo-100 rounded-3xl p-6 mb-6 min-h-[160px] flex flex-col items-center justify-center text-center">
                <p id="scenario-text" class="text-slate-800 font-semibold text-lg leading-snug"></p>
            </div>
            <div id="choices-grid" class="grid grid-cols-1 gap-3"></div>
            <div id="feedback-box" class="hidden mt-6 p-5 rounded-2xl text-sm font-bold text-center"></div>
        </div>
    </div>

    <div id="win-modal" class="fixed inset-0 bg-indigo-950/90 backdrop-blur-md hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-[40px] p-12 max-w-md w-full text-center">
            <h2 class="text-3xl font-black text-indigo-900 mb-2">TEBRİKLER!</h2>
            <p id="final-score-text" class="text-slate-600 mb-8"></p>
            <button onclick="location.reload()" class="w-full bg-indigo-600 text-white font-bold py-5 rounded-2xl">Yeniden Başla</button>
        </div>
    </div>

    <script>
        const scenarios = [
            { label: "Ön Hazırlık", text: "Sınavların yaklaşıyor. Ne yaparsın?", choices: [{ text: "Hemen bir plan yapıp çalışmaya başlarım.", correct: true, stat: "sebat", bonus: 20 }, { text: "Son güne kadar beklerim.", correct: false, stat: "sebat", penalty: 15 }] },
            { label: "Ders Esnası", text: "Ders çok sıkıcı gelmeye başladı...", choices: [{ text: "Öğretmene odaklanmaya çalışırım.", correct: true, stat: "dikkat", bonus: 20 }, { text: "Hayallere dalarım.", correct: false, stat: "dikkat", penalty: 15 }] }
        ];
        let currentStep = 0, stats = { sebat: 50, dikkat: 50 };
        function updateUI() {
            document.getElementById('bar-sebat').style.width = stats.sebat + "%";
            document.getElementById('bar-dikkat').style.width = stats.dikkat + "%";
            if (currentStep < scenarios.length) {
                document.getElementById('display-label').innerText = scenarios[currentStep].label;
                document.getElementById('scenario-text').innerText = scenarios[currentStep].text;
                const grid = document.getElementById('choices-grid'); grid.innerHTML = "";
                scenarios[currentStep].choices.forEach(c => {
                    const b = document.createElement('button');
                    b.className = "w-full text-left p-4 rounded-xl border-2 hover:bg-indigo-50 font-bold";
                    b.innerText = c.text; b.onclick = () => {
                        if(c.correct) { stats[c.stat] += c.bonus; currentStep++; } 
                        else { stats[c.stat] -= c.penalty; }
                        updateUI();
                    };
                    grid.appendChild(b);
                });
            } else { document.getElementById('win-modal').classList.remove('hidden'); }
        }
        window.onload = () => { setTimeout(() => { document.getElementById('loader').style.display='none'; document.getElementById('game-box').style.opacity='1'; updateUI(); }, 1000); };
    </script>
</body>
</html>
